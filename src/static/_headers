# Cabeçalhos do Cloudflare Workers Static Assets (https://developers.cloudflare.com/workers/static-assets/headers/)
# O Cloudflare lê este arquivo no deploy e aplica as regras; ele não é servido como página.
# HTML fica com o padrão do Cloudflare (revalida sempre), então uma publicação nova aparece na hora.

# CSS/JS têm hash no nome e as fontes não mudam: cache de 1 ano no navegador.
# Se trocar um arquivo de fonte, troque também o nome dele.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

/*
  Content-Security-Policy: default-src 'self'; script-src 'self' https://static.cloudflareinsights.com; connect-src 'self' https://cloudflareinsights.com; img-src 'self' data: https://images.unsplash.com; style-src 'self'; font-src 'self'; frame-src https://www.google.com; base-uri 'self'; form-action 'self'; frame-ancestors 'none'; object-src 'none'
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=()
